{
	"$schema": "https://developer.microsoft.com/json-schemas/spfx/client-side-web-part-manifest.schema.json",
	"id": "49cb2a0d-82ac-4f92-b022-4b9a0532a121",
	"alias": "LandingCtaWebPart",
	"componentType": "WebPart",
	// The "*" signifies that the version should be taken from the package.json
	"version": "*",
	"manifestVersion": 2,
	// If true, the component can only be installed on sites where Custom Script is allowed.
	// Components that allow authors to embed arbitrary script code should set this to true.
	// https://support.office.com/en-us/article/Turn-scripting-capabilities-on-or-off-1f2c515f-5d7e-448a-9fd7-835da935584f
	"requiresCustomScript": false,
	"supportedHosts": [
		"SharePointWebPart",
		"TeamsPersonalApp",
		"TeamsTab",
		"SharePointFullPage"
	],
	"supportsThemeVariants": true,
	"supportsFullBleed": true,
	"preconfiguredEntries": [
		{
			"groupId": "5c03119e-3074-46fd-976b-c60198311f70", // Advanced
			"group": {
				"default": "Advanced"
			},
			"title": {
				"default": "Landing CTA Hero"
			},
			"description": {
				"default": "Full-width landing hero with editable heading, subheading, background image, and CTA button."
			},
			"officeFabricIconFontName": "Page",
			"properties": {
				"heading": "Welcome to Blue Vest AI",
				"subheading": "Explore our services and connect with our team.",
				"buttonText": "Book an Appointment",
				"buttonUrl": "",
				"openInNewTab": true,
				"backgroundImage": "",
				"backgroundColor": "#163b58",
				"overlayOpacity": 45,
				"heightPreset": "viewport",
				"textAlignment": "center",
				"headingSize": 52,
				"headingWeight": "700",
				"headingItalic": false,
				"headingColor": "#ffffff",
				"subheadingSize": 20,
				"subheadingWeight": "400",
				"subheadingItalic": false,
				"subheadingColor": "#f0f4f8",
				"buttonTextSize": 16,
				"buttonWeight": "600",
				"buttonTextColor": "#163b58",
				"buttonBackgroundColor": "#ffffff",
				"buttonPaddingY": 10,
				"buttonPaddingX": 24,
				"buttonBorderRadius": 6
			}
		}
	]
}